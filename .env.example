# Supabase — pre-populated in the hosted environment, add these for local development
REACT_APP_SUPABASE_URL=https://your-project.supabase.co
REACT_APP_SUPABASE_ANON_KEY=your-anon-key-here

# IPGeolocation API key — server-side only, set as a Supabase Edge Function secret
# Do NOT put this in client-side .env files
# Configure via: Supabase Dashboard > Edge Functions > Secrets
# IPGEOLOCATION_API_KEY=your-api-key-here
