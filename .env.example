# TZInfo.org configuration
# The clock uses the browser's native Intl.DateTimeFormat API with IANA
# timezone identifiers (the TZ database maintained by TZInfo.org).
# No external API calls are made and no API key is required.
# These variables are structured for future extensibility.
TZINFO_API_URL=https://www.tzinfo.org/
TZINFO_API_KEY=
