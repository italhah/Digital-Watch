# TZInfo.org configuration (optional — not required for the clock to work)
# The app uses the browser's native Intl.DateTimeFormat API with IANA timezone
# identifiers, which does not require an external API call or key.
# These variables are structured for future use if a TZInfo endpoint is added.
TZINFO_API_URL=https://www.tzinfo.org/
TZINFO_API_KEY=
